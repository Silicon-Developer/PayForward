    <!-- Permission Rationales -->
    <string name="sms_permission_rationale">PayForward needs SMS access to read incoming transaction messages. All processing happens locally on your device — no message data is sent anywhere except your configured forwarding destination.</string>
    <string name="notification_permission_rationale">PayForward needs notification access to capture transaction alerts from payment apps like GPay, PhonePe, and Paytm. Only notification content matching your keywords is processed.</string>

